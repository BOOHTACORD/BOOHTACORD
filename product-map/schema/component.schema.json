{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.boohtacord.invalid/product-map/component.schema.json",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^cmp(\\.[a-z0-9_-]+)+$"},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^cmp(\\.[a-z0-9_-]+)+$"}},
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object", "required": ["parity_id", "platform"], "additionalProperties": false,
      "properties": {
        "parity_id": {"type": "string", "minLength": 1},
        "platform": {"enum": ["web", "android", "ios"]}
      }
    }
  },
  "oneOf": [{"required": ["paths"]}, {"required": ["source"]}]
}
