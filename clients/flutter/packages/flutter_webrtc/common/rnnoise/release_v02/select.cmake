option(BOOHTA_RNNOISE_RELEASE_V02 "Bundle the official RNNoise 0.2 distribution on Windows" ${WIN32})
if(BOOHTA_RNNOISE_RELEASE_V02 OR (WIN32 AND BINARY_NAME))
  include("${CMAKE_CURRENT_LIST_DIR}/root.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/deepfilter.cmake")
if(BOOHTA_RNNOISE_RELEASE_V02 AND NOT DEFINED ENV{BOOHTA_RNNOISE_V02_SOURCE})
  include("${CMAKE_CURRENT_LIST_DIR}/library.cmake")
else()
  include("${CMAKE_CURRENT_LIST_DIR}/../research_v02/library.cmake")
endif()
if(BOOHTA_RNNOISE_TESTS AND BOOHTA_RNNOISE_RELEASE_V02 AND NOT DEFINED ENV{BOOHTA_RNNOISE_V02_SOURCE})
  add_executable(rnnoise_release_model_test "${CMAKE_CURRENT_LIST_DIR}/model_test.cc")
  target_link_libraries(rnnoise_release_model_test PRIVATE boohta_rnnoise)
  if(MSVC)
    target_compile_options(rnnoise_release_model_test PRIVATE /UNDEBUG)
  else()
    target_compile_options(rnnoise_release_model_test PRIVATE -UNDEBUG)
  endif()
  add_test(NAME rnnoise_release_model_test COMMAND rnnoise_release_model_test)
endif()
