+// Exercise the real AudioState -> AudioTransport -> AudioSendStream route.
+// The existing test sink observes encoder delivery; no overlap model is used.
+void FeedBoohtacordDevicePCM(ConfigHelper& helper) {
+  std::array<int16_t, 160> pcm{};
+  uint32_t microphone_level = 0;
+  ASSERT_EQ(0, helper.device_transport()->RecordedDataIsAvailable(
+      pcm.data(), 160, sizeof(int16_t), 1, 16000, 0, 0, 0, false,
+      microphone_level));
+}
+
+TEST(AudioSendStreamTest, BoohtacordCustomExcludedAfterEncoderUpdate) {
+  ConfigHelper helper(false, true, true);
+  helper.config().source_type = AudioSourceInterface::SourceType::kCustom;
+  auto stream = helper.CreateAudioSendStream();
+  EXPECT_CALL(*helper.channel_send(), StartSend()).Times(1);
+  EXPECT_CALL(*helper.channel_send(), StopSend()).Times(1);
+  EXPECT_CALL(*helper.channel_send(), ProcessAndEncodeAudio).Times(0);
+  stream->Start();
+  FeedBoohtacordDevicePCM(helper);
+  helper.SetupMockForSetupSendCodec(true);
+  auto next = helper.config();
+  next.send_codec_spec = AudioSendStream::Config::SendCodecSpec(111, kOpusFormat);
+  stream->Reconfigure(next, nullptr);
+  FeedBoohtacordDevicePCM(helper);
+  stream->Stop();
+}
+
+TEST(AudioSendStreamTest, BoohtacordMicrophoneRouteSurvivesTypeChanges) {
+  ConfigHelper helper(false, true, true);
+  auto stream = helper.CreateAudioSendStream();
+  EXPECT_CALL(*helper.channel_send(), StartSend()).Times(3);
+  EXPECT_CALL(*helper.channel_send(), StopSend()).Times(3);
+  EXPECT_CALL(*helper.channel_send(), ProcessAndEncodeAudio).Times(2);
+  stream->Start();
+  FeedBoohtacordDevicePCM(helper);
+  stream->Stop();
+  auto next = helper.config();
+  next.source_type = AudioSourceInterface::SourceType::kCustom;
+  stream->Reconfigure(next, nullptr);
+  stream->Start();
+  FeedBoohtacordDevicePCM(helper);
+  stream->Stop();
+  next.source_type = AudioSourceInterface::SourceType::kAudioDeviceModule;
+  stream->Reconfigure(next, nullptr);
+  stream->Start();
+  FeedBoohtacordDevicePCM(helper);
+  stream->Stop();
+}
+
