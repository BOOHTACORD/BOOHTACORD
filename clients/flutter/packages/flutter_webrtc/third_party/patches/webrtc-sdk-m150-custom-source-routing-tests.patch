+TEST(AudioSendStreamTest, CustomSourceExcludesAdmAcrossCodecChangeAndRestart) {
+  ConfigHelper helper(false, true, true);
+  helper.config().source_type = AudioSourceInterface::SourceType::kCustom;
+  auto send_stream = helper.CreateAudioSendStream();
+  int encoded_frames = 0;
+  EXPECT_CALL(*helper.channel_send(), ProcessAndEncodeAudio)
+      .WillRepeatedly([&](std::unique_ptr<AudioFrame>) { ++encoded_frames; });
+  EXPECT_CALL(*helper.channel_send(), StartSend()).Times(2);
+  EXPECT_CALL(*helper.channel_send(), StopSend()).Times(2);
+
+  send_stream->Start();
+  helper.DeliverAdmFrame();
+  EXPECT_EQ(encoded_frames, 0);
+  send_stream->SendAudioData(CreateAudioFrame1kHzSineWave(1200, 10, 48000, 1));
+  EXPECT_EQ(encoded_frames, 1);
+
+  helper.SetupMockForSetupSendCodec(true);
+  helper.config().send_codec_spec =
+      AudioSendStream::Config::SendCodecSpec(111, kOpusFormat);
+  send_stream->Reconfigure(helper.config(), nullptr);
+  helper.DeliverAdmFrame();
+  EXPECT_EQ(encoded_frames, 1);
+
+  send_stream->Stop();
+  helper.DeliverAdmFrame();
+  EXPECT_EQ(encoded_frames, 1);
+  send_stream->Start();
+  helper.DeliverAdmFrame();
+  EXPECT_EQ(encoded_frames, 1);
+  send_stream->SendAudioData(CreateAudioFrame1kHzSineWave(1200, 10, 48000, 1));
+  EXPECT_EQ(encoded_frames, 2);
+  send_stream->Stop();
+}
+
+TEST(AudioSendStreamTest, DeviceSourceKeepsAdmAcrossRestart) {
+  ConfigHelper helper(false, true, true);
+  auto send_stream = helper.CreateAudioSendStream();
+  int encoded_frames = 0;
+  EXPECT_CALL(*helper.channel_send(), ProcessAndEncodeAudio)
+      .WillRepeatedly([&](std::unique_ptr<AudioFrame>) { ++encoded_frames; });
+  EXPECT_CALL(*helper.channel_send(), StartSend()).Times(2);
+  EXPECT_CALL(*helper.channel_send(), StopSend()).Times(2);
+
+  send_stream->Start();
+  helper.DeliverAdmFrame();
+  EXPECT_EQ(encoded_frames, 1);
+  send_stream->Stop();
+  helper.DeliverAdmFrame();
+  EXPECT_EQ(encoded_frames, 1);
+  send_stream->Start();
+  helper.DeliverAdmFrame();
+  EXPECT_EQ(encoded_frames, 2);
+  send_stream->Stop();
+}
