# Windows has its own WGC-capable SDK pin; Linux retains its existing binary.
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
file(STRINGS "${_root}/libwebrtc_version.ini" _lines)
foreach(_line IN LISTS _lines)
  if(_line MATCHES "^([a-z0-9_]+)[ \t]*=[ \t]*(.*)$")
    string(STRIP "${CMAKE_MATCH_2}" _value)
    set("_pin_${CMAKE_MATCH_1}" "${_value}")
  endif()
endforeach()
set(_version "${_pin_windows_binary_version}")
if(NOT _version MATCHES "^[A-Za-z0-9._-]+$")
  message(FATAL_ERROR "Missing pinned Windows libwebrtc version")
endif()
string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" _platform)
if(_platform STREQUAL "arm64")
  set(_arch arm64)
  set(_digest "${_pin_windows_arm64_sha256}")
elseif((_platform STREQUAL "x64" OR _platform STREQUAL "") AND CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(_arch x64)
  set(_digest "${_pin_windows_sha256}")
else()
  message(FATAL_ERROR "Unsupported Windows libwebrtc architecture")
endif()
string(LENGTH "${_digest}" _digest_length)
if(NOT _digest_length EQUAL 64 OR NOT _digest MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Windows SDK requires a pinned SHA256")
endif()
set(_asset "libwebrtc-win-${_arch}-release.zip")
set(_zip "${_root}/downloads/${_version}/${_asset}")
set(_cache "${_root}/sdks/${_version}/win-${_arch}")
set(LIBWEBRTC_SDK_DIR "${_cache}/libwebrtc")
if(NOT EXISTS "${_zip}")
  file(MAKE_DIRECTORY "${_root}/downloads/${_version}")
  string(REGEX REPLACE "/+$" "" _url "${_pin_download_url}")
  file(DOWNLOAD "${_url}/${_version}/${_asset}" "${_zip}"
    EXPECTED_HASH "SHA256=${_digest}" TLS_VERIFY ON STATUS _status)
  list(GET _status 0 _code)
  if(NOT _code EQUAL 0)
    message(FATAL_ERROR "Pinned Windows SDK download failed: ${_status}")
  endif()
endif()
file(SHA256 "${_zip}" _actual)
if(NOT _actual STREQUAL _digest)
  message(FATAL_ERROR "Cached Windows SDK SHA256 differs from the pinned archive")
endif()
if(NOT EXISTS "${LIBWEBRTC_SDK_DIR}/include/rtc_desktop_device.h" OR
   NOT EXISTS "${LIBWEBRTC_SDK_DIR}/lib/libwebrtc.dll" OR
   NOT EXISTS "${LIBWEBRTC_SDK_DIR}/lib/libwebrtc.dll.lib")
  file(MAKE_DIRECTORY "${_cache}")
  include("${CMAKE_CURRENT_LIST_DIR}/extract_sdk.cmake")
  _libwebrtc_extract_and_normalize("${_zip}" "${_cache}")
endif()
foreach(_required include/rtc_desktop_device.h lib/libwebrtc.dll lib/libwebrtc.dll.lib)
  if(NOT EXISTS "${LIBWEBRTC_SDK_DIR}/${_required}")
    message(FATAL_ERROR "Pinned Windows SDK archive is incomplete: ${_required}")
  endif()
endforeach()
