{
  "name": "voice-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "render:social-preview": "node scripts/render_social_preview.mjs",
    "verify:social-preview": "node scripts/verify_social_preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:screen-profile": "playwright test -c tests/screen_profile/playwright.config.ts",
    "test:screen-profile-sfu": "playwright test -c tests/screen_profile/screen_share_sfu.playwright.config.ts",
    "test:member-popover": "playwright test -c tests/member_popover/playwright.config.ts",
    "test:mentions-inbox": "playwright test -c tests/mentions_inbox/playwright.config.ts",
    "test:password-generation": "playwright test -c tests/password_generation/playwright.config.ts",
    "test:voice-shortcuts": "playwright test -c tests/voice_shortcuts/playwright.config.ts",
    "test:voice-disconnect-notice": "playwright test -c tests/voice_disconnect_notice/playwright.config.ts",
    "test:responsive-shell": "playwright test -c tests/responsive_shell/playwright.config.ts",
    "test:controls": "playwright test -c tests/control_consistency/playwright.config.ts",
    "test:microcopy": "playwright test -c tests/microcopy/playwright.config.ts",
    "test:accessibility": "playwright test -c tests/accessibility/playwright.config.ts && playwright test -c tests/conversation_action_disclosure/playwright.config.ts --grep axe",
    "test:audio": "playwright test -c tests/audio/playwright.config.ts",
    "test:audio:quality": "node ../../tools/audio/quality_harness.mjs",
    "test:audio:browser": "playwright test -c tests/audio/playwright.config.ts",
    "test:restricted-networks": "playwright test -c tests/restricted_networks/playwright.config.ts",
    "test:own-sessions": "playwright test -c tests/own_sessions/playwright.config.ts",
    "test:readonly-archive": "playwright test -c tests/readonly_archive/playwright.config.ts",
    "test:search-dates": "playwright test -c tests/search_dates/playwright.config.ts",
    "test:delivery": "playwright test -c tests/delivery_uncertainty/playwright.config.ts",
    "test:guild-lifecycle": "playwright test --config tests/guild_lifecycle/playwright.config.ts",
    "test:search-sessions": "playwright test -c tests/search_sessions/playwright.config.ts",
    "test:dm-starter": "playwright test -c tests/dm_starter/playwright.config.ts",
    "test:chat-rhythm": "playwright test -c tests/chat_rhythm/playwright.config.ts",
    "test:message-social": "playwright test -c tests/message_social/playwright.config.ts",
    "test:navigation": "playwright test -c tests/navigation_density/playwright.config.ts",
    "test:search-presentation": "playwright test -c tests/search_presentation/playwright.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-zone": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "livekit-client": "2.22.3",
    "pinia": "4.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@livekit/throws-transformer": "^0.1.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/sdp-transform": "^2.15.0",
    "@vitejs/plugin-vue": "6.0.9",
    "axe-core": "4.11.4",
    "livekit-server-sdk": "2.19.1",
    "postcss": "8.5.28",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
