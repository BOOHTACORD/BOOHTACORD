{
  "uid": "addressed-notifications-v1",
  "title": "Addressed notifications: stages and unknown outcomes",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "notifications",
    "privacy"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(boohtacord_notification_observer_up,instance)",
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "transport",
        "type": "custom",
        "query": "none,web_push,mobile_relay",
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Observation (missing means unknown)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boohtacord_notification_observer_up{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Durable stages: acceptance, opened and read are distinct",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(stage,reason,transport)(increase(boohtacord_notification_results_total{instance=~\"$instance\",transport=~\"$transport\"}[$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Finite queue / in-flight",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boohtacord_notification_queue{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Technical oldest due age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boohtacord_notification_oldest_due_seconds{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Worker iterations (0 means failed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boohtacord_notification_worker_health{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Active registrations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boohtacord_notification_active_subscriptions{instance=~\"$instance\",transport=~\"$transport\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Processing p95 (due excludes grace/attention)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,stage)(rate(boohtacord_notification_processing_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Relay independent outcomes",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(outcome,namespace)(increase(boohtacord_push_relay_results_total[$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Relay finite queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boohtacord_push_relay_queue_pending"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Sending enabled (separate from account/device consent)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boohtacord_notification_sending_enabled{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "text",
      "title": "Meaning and investigation",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Provider/relay acceptance is not observed OS display. Opened is authenticated tap handling; read remains the server read cursor. Display is unknown without a device observation. Suppression is intentional and excluded from provider error ratios. Missing scrape/data is unknown. Thresholds are initial engineering alerts, not measured SLO. Investigate short notification.plan / claim / attempt / resolve spans in Tempo; no capability references, endpoint, body or device IDs are exported."
      }
    }
  ],
  "links": [
    {
      "title": "Investigate real error/action traces (notification.attempt / resolve)",
      "type": "link",
      "url": "/d/boohtacord-traces",
      "keepTime": true,
      "targetBlank": true,
      "icon": "external link"
    }
  ]
}
