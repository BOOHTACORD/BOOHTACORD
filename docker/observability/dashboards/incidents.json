{
  "uid": "boohtacord-incidents",
  "title": "BOOHTACORD | Incidents",
  "tags": [
    "boohtacord",
    "sre"
  ],
  "schemaVersion": 40,
  "version": 0,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Safe incident signals. Verify collector target, API collection age and operation age before interpreting traffic. No data never means zero. Not proof of physical media capability.",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {"id": 1, "title": "Collector scrape age", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "time() - timestamp(up{job=\"boohtacord-otel-metrics\"})", "legendFormat": "", "instant": true}], "description": "", "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 2, "title": "Collector target up (absence differs from 0)", "type": "stat", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "up{job=\"boohtacord-otel-metrics\"}", "legendFormat": "", "instant": true}], "description": "", "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 3, "title": "API metric collection age", "type": "stat", "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "time() - boohtacord_incident_api_collection_timestamp_seconds{job=\"boohtacord-otel-metrics\"}", "legendFormat": "", "instant": true}], "description": "API collection is recorded before export. Collector up does not imply the API exporter is current; investigate age >45 seconds.", "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 4, "title": "API telemetry missing", "type": "stat", "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "absent(boohtacord_incident_api_collection_timestamp_seconds{job=\"boohtacord-otel-metrics\"})", "legendFormat": "", "instant": true}], "description": "1 = no exported API observation; empty = present. Never substitute missing counters with zero.", "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 5, "title": "5xx rate by route", "type": "timeseries", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "sum by (method,route) (rate(boohtacord_incident_http_requests_total{job=\"boohtacord-otel-metrics\",status=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{method}} {{route}}", "instant": false}], "description": "", "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 6, "title": "p95 by route", "type": "timeseries", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95,sum by(le,method,route)(rate(boohtacord_incident_http_duration_seconds_bucket{job=\"boohtacord-otel-metrics\"}[$__rate_interval])))", "legendFormat": "{{method}} {{route}}", "instant": false}], "description": "WebSocket requests measure total connection lifetime; use existing readiness/delivery metrics for streaming performance.", "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 7, "title": "Operational completions by status", "type": "timeseries", "gridPos": {"x": 0, "y": 21, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "sum by(operation,status)(rate(boohtacord_incident_operational_requests_total{job=\"boohtacord-otel-metrics\"}[$__rate_interval]))", "legendFormat": "{{operation}} {{status}}", "instant": false}], "description": "", "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 8, "title": "Operation failure/timeout rate", "type": "timeseries", "gridPos": {"x": 12, "y": 21, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "sum by(operation,outcome)(rate(boohtacord_incident_operations_total{job=\"boohtacord-otel-metrics\",outcome!=\"success\"}[$__rate_interval]))", "legendFormat": "{{operation}} {{outcome}}", "instant": false}], "description": "", "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 9, "title": "Dependency latest result", "type": "timeseries", "gridPos": {"x": 0, "y": 28, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "boohtacord_incident_last_successful{job=\"boohtacord-otel-metrics\",operation=~\"livekit_probe|storage_probe|trace_export|metric_export|relay_export\"}", "legendFormat": "{{operation}}", "instant": false}], "description": "0 = observed failure; no data = unobserved or disabled. Probe success does not prove media capability or collector persistence.", "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 10, "title": "Dependency successful observation age", "type": "timeseries", "gridPos": {"x": 12, "y": 28, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "time() - boohtacord_incident_last_success_timestamp_seconds{job=\"boohtacord-otel-metrics\",operation=~\"livekit_probe|storage_probe|trace_export|metric_export|relay_export\"}", "legendFormat": "{{operation}}", "instant": false}], "description": "", "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 11, "title": "Operation stale signal", "type": "timeseries", "gridPos": {"x": 0, "y": 35, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "boohtacord_incident_stale{job=\"boohtacord-otel-metrics\"}", "legendFormat": "{{operation}}", "instant": false}], "description": "1 if no success or threshold exceeded: probes/workers45s, exporters180s, on-demand operations300s. Stopped API requires collection-age panel because cached stale gauges stop changing.", "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 12, "title": "Last successful export timestamp", "type": "timeseries", "gridPos": {"x": 12, "y": 35, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "boohtacord_incident_last_success_timestamp_seconds{job=\"boohtacord-otel-metrics\",operation=~\"trace_export|metric_export|relay_export\"}", "legendFormat": "{{operation}}", "instant": false}], "description": "", "fieldConfig": {"defaults": {"unit": "dateTimeAsIso", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 13, "title": "DB saturation acquired/max", "type": "timeseries", "gridPos": {"x": 0, "y": 42, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "boohtacord_incident_database_pool{job=\"boohtacord-otel-metrics\",stat=\"acquired\"} / ignoring(stat) boohtacord_incident_database_pool{job=\"boohtacord-otel-metrics\",stat=\"max\"}", "legendFormat": "", "instant": false}], "description": "", "fieldConfig": {"defaults": {"unit": "percentunit", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 14, "title": "DB pool connections", "type": "timeseries", "gridPos": {"x": 12, "y": 42, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "boohtacord_incident_database_pool{job=\"boohtacord-otel-metrics\",stat=~\"acquired|idle|total|max|constructing\"}", "legendFormat": "{{stat}}", "instant": false}], "description": "", "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 15, "title": "DB pending acquisitions", "type": "timeseries", "gridPos": {"x": 0, "y": 49, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "boohtacord_incident_database_acquires_pending{job=\"boohtacord-otel-metrics\"}", "legendFormat": "", "instant": false}], "description": "In-flight attempts include connection construction and waiting; not an exact pool waiter count.", "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 16, "title": "DB acquire p95 including failures", "type": "timeseries", "gridPos": {"x": 12, "y": 49, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95,sum by(le,outcome)(rate(boohtacord_incident_database_acquire_duration_seconds_bucket{job=\"boohtacord-otel-metrics\"}[$__rate_interval])))", "legendFormat": "{{outcome}}", "instant": false}], "description": "", "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 17, "title": "DB acquire failures/timeouts", "type": "timeseries", "gridPos": {"x": 0, "y": 56, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "sum by(outcome)(rate(boohtacord_incident_database_acquires_total{job=\"boohtacord-otel-metrics\",outcome!=\"success\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "instant": false}], "description": "", "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 18, "title": "DB empty-acquire wait rate", "type": "timeseries", "gridPos": {"x": 12, "y": 56, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "rate(boohtacord_incident_database_pool_empty_acquire_wait_seconds_total{job=\"boohtacord-otel-metrics\"}[$__rate_interval])", "legendFormat": "", "instant": false}], "description": "Native cumulative successful empty-pool wait, exported as observable counter; acquire histogram includes failures too.", "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 19, "title": "LiveKit probe never observed", "type": "stat", "gridPos": {"x": 0, "y": 63, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "absent(boohtacord_incident_last_attempt_timestamp_seconds{job=\"boohtacord-otel-metrics\",operation=\"livekit_probe\"})", "legendFormat": "", "instant": true}], "description": "", "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 20, "title": "Storage probe never observed", "type": "stat", "gridPos": {"x": 12, "y": 63, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "absent(boohtacord_incident_last_attempt_timestamp_seconds{job=\"boohtacord-otel-metrics\",operation=\"storage_probe\"})", "legendFormat": "", "instant": true}], "description": "", "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data / unobserved"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 21, "title": "Exporter configuration", "type": "stat", "gridPos": {"x": 0, "y": 70, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"refId": "A", "expr": "boohtacord_incident_enabled{job=\"boohtacord-otel-metrics\"}", "legendFormat": "{{operation}}", "instant": true}], "description": "0 intentionally disabled; 1 configured. Enabled does not prove successful delivery.", "fieldConfig": {"defaults": {"noValue": "No data / unobserved"}, "overrides": []}}
  ]
}
