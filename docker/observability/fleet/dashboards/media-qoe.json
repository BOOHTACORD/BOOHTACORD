{
  "uid": "boohtacord-fleet-media-qoe",
  "title": "Installation · Media QoE",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "boohtacord",
    "installation-scoped"
  ],
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "installation",
        "label": "Installation",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "boohtacord_prometheus"
        },
        "query": "label_values(boohtacord_installation_registered, installation_id)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Observed frame cadence",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boohtacord_prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (installation_id, le, direction) (rate(boohtacord_media_fps_bucket{installation_id=\"$installation\"}[5m])))"
        }
      ],
      "links": [
        {
          "title": "Installation traces",
          "url": "/d/boohtacord-fleet-traces?var-installation=${installation}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Observed bitrate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boohtacord_prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (installation_id, le, direction) (rate(boohtacord_media_bitrate_kbps_bucket{installation_id=\"$installation\"}[5m])))"
        }
      ],
      "links": [
        {
          "title": "Installation traces",
          "url": "/d/boohtacord-fleet-traces?var-installation=${installation}"
        }
      ]
    }
  ],
  "description": "Registered opt-in installations only. Legacy/local history remains in the original dashboards; it is never attributed to an installation."
}
