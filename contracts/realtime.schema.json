{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-platform.invalid/contracts/realtime.schema.json",
  "title": "RealtimeEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "kind", "occurred_at", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "kind": {
      "type": "string",
      "enum": ["connection.ready", "connection.resync_required", "voice.lease_revoked", "channel.updated", "guild.profile.updated", "member.profile.updated", "presence.snapshot", "presence.changed", "message.created", "message.updated", "message.deleted", "direct_message.message_created", "direct_message.message_updated", "direct_message.message_deleted", "role.permissions.updated", "auth.permissions.invalidated", "session.state_changed", "screen_preview.updated", "screen_preview.invalidated", "screen_viewers.changed", "message.reactions_updated", "message.pins_updated", "direct_message.reactions_updated"]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "trace_id", "span_id"],
      "properties": {
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "trace_id": { "type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$" },
        "span_id": { "type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$" }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "session.state_changed"}}, "required": ["kind"]}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "maxProperties": 0}}}},
    {"if": {"properties": {"kind": {"const": "guild.profile.updated"}}, "required": ["kind"]}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["revision"], "properties": {"revision": {"type": "integer", "minimum": 1}}}}}},
    {"if": {"properties": {"kind": {"const": "member.profile.updated"}}, "required": ["kind"]}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["user_id", "revision"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "revision": {"type": "integer", "minimum": 1}}}}}},
    {
      "if": { "properties": { "kind": { "const": "connection.resync_required" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {
              "reason": { "type": "string", "enum": ["event_overflow", "server_restart", "cursor_expired", "cursor_invalid", "replay_limit", "replay_unavailable"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "voice.lease_revoked" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lease_id", "reason"],
            "properties": {
              "lease_id": { "type": "string", "format": "uuid" },
              "reason": { "type": "string", "enum": ["TRANSFER", "KICK", "CHANNEL_CLOSED", "SESSION_REVOKED", "BANNED", "LOGOUT", "VOLUNTARY_LEAVE"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "channel.updated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revision"],
            "properties": { "revision": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "role.permissions.updated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "revision"],
            "properties": {
              "role": { "const": "MEMBER" },
              "revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "auth.permissions.invalidated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "direct_message.message_created" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direct_message_id", "message_id"],
            "properties": {
              "direct_message_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "direct_message.message_updated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direct_message_id", "message_id", "revision"],
            "properties": {
              "direct_message_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" },
              "revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "direct_message.message_deleted" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direct_message_id", "message_id", "revision"],
            "properties": {
              "direct_message_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" },
              "revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "enum": ["message.created", "message.updated", "message.deleted"] } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel_id", "message_id"],
            "properties": {
              "channel_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "presence.snapshot" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["online_user_ids"],
            "properties": { "online_user_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "presence.changed" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user_id", "presence"],
            "properties": {
              "user_id": { "type": "string", "format": "uuid" },
              "presence": { "type": "string", "enum": ["online", "offline"] }
            }
          }
        }
      }
    }, {
      "if": { "properties": { "kind": { "const": "screen_preview.updated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": ["lease_id", "generation_id", "revision"],
            "properties": {
              "lease_id": { "type": "string", "format": "uuid" },
              "generation_id": { "type": "string", "format": "uuid" },
              "revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }, {
      "if": { "properties": { "kind": { "const": "screen_preview.invalidated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": ["lease_id", "generation_id"],
            "properties": {
              "lease_id": { "type": "string", "format": "uuid" },
              "generation_id": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "screen_viewers.changed" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 }
        }
      }
    },
    {"if": {"properties": {"kind": {"enum": ["message.reactions_updated","message.pins_updated"]}},"required": ["kind"]},"then": {"properties": {"payload": {"type": "object","additionalProperties": false,"required": ["channel_id","message_id"],"properties": {"channel_id": {"type": "string","format": "uuid"},"message_id": {"type": "string","format": "uuid"}}}}}},
    {"if": {"properties": {"kind": {"enum": ["direct_message.reactions_updated"]}},"required": ["kind"]},"then": {"properties": {"payload": {"type": "object","additionalProperties": false,"required": ["direct_message_id","message_id"],"properties": {"direct_message_id": {"type": "string","format": "uuid"},"message_id": {"type": "string","format": "uuid"}}}}}}
  ]
}
