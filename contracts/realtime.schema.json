{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-platform.invalid/contracts/realtime.schema.json",
  "title": "RealtimeEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "kind", "occurred_at", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "kind": {
      "type": "string",
      "enum": ["maintenance.snapshot", "maintenance.changed", "voice.roster.snapshot", "voice.roster.unavailable", "voice.roster.snapshot.v2", "voice.roster.unavailable.v2", "notification.queued", "notification.preferences_changed", "connection.ready", "connection.heartbeat", "connection.resync_required", "voice.lease_revoked", "channel.updated", "guild.profile.updated", "member.profile.updated", "presence.snapshot", "presence.changed", "message.created", "message.updated", "message.deleted", "direct_message.message_created", "direct_message.message_updated", "direct_message.message_deleted", "role.permissions.updated", "auth.permissions.invalidated", "session.state_changed", "screen_preview.updated", "screen_preview.invalidated", "screen_viewers.changed", "screen_telemetry.updated", "message.reactions_updated", "message.pins_updated", "direct_message.reactions_updated"]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "trace_id", "span_id"],
      "properties": {
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "trace_id": { "type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$" },
        "span_id": { "type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$" }
      }
    }
  },
  "$defs": {
    "VoiceRosterParticipant": {
      "type": "object", "additionalProperties": false,
      "required": ["account_id", "display_name", "screen_sharing", "microphone_muted"],
      "properties": {"account_id": {"type": "string", "format": "uuid"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 64}, "screen_sharing": {"type": "boolean"}, "microphone_muted": {"type": "boolean"}}
    },
    "VoiceRosterChannel": {
      "type": "object", "additionalProperties": false, "required": ["channel_id", "participants"],
      "properties": {"channel_id": {"type": "string", "format": "uuid"}, "participants": {"type": "array", "items": {"$ref": "#/$defs/VoiceRosterParticipant"}}}
    },
    "VoiceRosterSnapshot": {
      "type": "object", "additionalProperties": false, "required": ["version", "generation", "revision", "observed_at", "channels"],
      "properties": {"version": {"const": 1}, "generation": {"type": "string", "format": "uuid"}, "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "observed_at": {"type": "string", "format": "date-time"}, "channels": {"type": "array", "items": {"$ref": "#/$defs/VoiceRosterChannel"}}}
    },
    "VoiceRosterUnavailable": {
      "type": "object", "additionalProperties": false, "required": ["version", "code"],
      "properties": {"version": {"const": 1}, "code": {"const": "temporarily_unavailable"}}
    },
    "VoiceRosterParticipantV2": {
      "type": "object", "additionalProperties": false,
      "required": ["account_id", "display_name", "screen_sharing", "microphone_muted", "deafened"],
      "properties": {"account_id": {"type": "string", "format": "uuid"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 64}, "screen_sharing": {"type": "boolean"}, "microphone_muted": {"type": "boolean"}, "deafened": {"type": "boolean"}}
    },
    "VoiceRosterChannelV2": {
      "type": "object", "additionalProperties": false, "required": ["channel_id", "participants"],
      "properties": {"channel_id": {"type": "string", "format": "uuid"}, "participants": {"type": "array", "items": {"$ref": "#/$defs/VoiceRosterParticipantV2"}}}
    },
    "VoiceRosterSnapshotV2": {
      "type": "object", "additionalProperties": false, "required": ["version", "generation", "revision", "observed_at", "channels"],
      "properties": {"version": {"const": 2}, "generation": {"type": "string", "format": "uuid"}, "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "observed_at": {"type": "string", "format": "date-time"}, "channels": {"type": "array", "items": {"$ref": "#/$defs/VoiceRosterChannelV2"}}}
    },
    "VoiceRosterUnavailableV2": {
      "type": "object", "additionalProperties": false, "required": ["version", "code"],
      "properties": {"version": {"const": 2}, "code": {"const": "temporarily_unavailable"}}
    },
    "ScreenTelemetryField": {
      "type": "object", "additionalProperties": false, "required": ["availability", "provenance"],
      "properties": {
        "value": {"type": "number"},
        "availability": {"type": "string", "enum": ["measured", "configured_only", "unsupported", "not_exposed", "permission_denied", "not_applicable", "stale"]},
        "provenance": {"type": "string", "enum": ["sender_measured", "configured", "unavailable"]}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"const": "measured"}}, "required": ["availability"]}, "then": {"required": ["value"], "properties": {"provenance": {"const": "sender_measured"}}}},
        {"if": {"properties": {"availability": {"const": "configured_only"}}, "required": ["availability"]}, "then": {"required": ["value"], "properties": {"provenance": {"const": "configured"}}}},
        {"if": {"properties": {"availability": {"enum": ["unsupported", "not_exposed", "permission_denied", "not_applicable", "stale"]}}, "required": ["availability"]}, "then": {"not": {"required": ["value"]}, "properties": {"provenance": {"const": "unavailable"}}}}
      ]
    },
    "ScreenTelemetryQualityReason": {
      "type": "object", "additionalProperties": false, "required": ["availability", "provenance"],
      "properties": {
        "value": {"type": "string", "enum": ["none", "bandwidth", "cpu", "encoder"]},
        "availability": {"type": "string", "enum": ["measured", "unsupported", "not_exposed", "permission_denied", "not_applicable", "stale"]},
        "provenance": {"type": "string", "enum": ["sender_measured", "unavailable"]}
      },
      "allOf": [
        {"if": {"properties": {"availability": {"const": "measured"}}, "required": ["availability"]}, "then": {"required": ["value"], "properties": {"provenance": {"const": "sender_measured"}}}},
        {"if": {"properties": {"availability": {"enum": ["unsupported", "not_exposed", "permission_denied", "not_applicable", "stale"]}}, "required": ["availability"]}, "then": {"not": {"required": ["value"]}, "properties": {"provenance": {"const": "unavailable"}}}}
      ]
    },
    "ScreenTelemetryEnvelopeV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "media_session_id", "publication_generation", "platform", "client_kind", "capability_version", "sequence", "capture", "encode", "transport"],
      "properties": {
        "schema_version": {"const": 1},
        "media_session_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,256}$"},
        "publication_generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "platform": {"type": "string", "enum": ["web", "android", "ios", "macos", "windows"]},
        "client_kind": {"type": "string", "enum": ["web", "flutter"]},
        "capability_version": {"type": "integer", "minimum": 1, "maximum": 16},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sender_sample_age_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
        "capture": {"type": "object", "additionalProperties": false, "required": ["width", "height", "fps"], "properties": {"width": {"allOf": [{"$ref": "#/$defs/ScreenTelemetryField"}, {"properties": {"value": {"type": "integer", "minimum": 1, "maximum": 16384}}}]}, "height": {"allOf": [{"$ref": "#/$defs/ScreenTelemetryField"}, {"properties": {"value": {"type": "integer", "minimum": 1, "maximum": 16384}}}]}, "fps": {"allOf": [{"$ref": "#/$defs/ScreenTelemetryField"}, {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 240}}}]}}},
        "encode": {"type": "object", "additionalProperties": false, "required": ["fps", "bitrate_bps"], "properties": {"fps": {"allOf": [{"$ref": "#/$defs/ScreenTelemetryField"}, {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 240}}}]}, "bitrate_bps": {"allOf": [{"$ref": "#/$defs/ScreenTelemetryField"}, {"properties": {"value": {"type": "integer", "minimum": 0, "maximum": 100000000}}}]}}},
        "transport": {"type": "object", "additionalProperties": false, "required": ["packet_loss_percent", "rtt_ms", "quality_limitation_reason"], "properties": {"packet_loss_percent": {"allOf": [{"$ref": "#/$defs/ScreenTelemetryField"}, {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 100}}}]}, "rtt_ms": {"allOf": [{"$ref": "#/$defs/ScreenTelemetryField"}, {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 60000}}}]}, "quality_limitation_reason": {"$ref": "#/$defs/ScreenTelemetryQualityReason"}}}
      },
      "allOf": [
        {"if": {"properties": {"platform": {"const": "web"}}, "required": ["platform"]}, "then": {"properties": {"client_kind": {"const": "web"}}}},
        {"if": {"properties": {"platform": {"enum": ["android", "ios", "macos", "windows"]}}, "required": ["platform"]}, "then": {"properties": {"client_kind": {"const": "flutter"}}}}
      ]
    },
    "ScreenTelemetryEventV1": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_lease_id", "server_received_at", "envelope"],
      "properties": {"owner_lease_id": {"type": "string", "format": "uuid"}, "server_received_at": {"type": "string", "format": "date-time"}, "envelope": {"$ref": "#/$defs/ScreenTelemetryEnvelopeV1"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "connection.heartbeat"}}, "required": ["kind"]}, "then": {"not": {"required": ["telemetry"]}, "properties": {"payload": {"type": "object", "additionalProperties": false}}}},
    {"if":{"properties":{"kind":{"const":"voice.roster.snapshot"}},"required":["kind"]},"then":{"properties":{"payload":{"$ref":"#/$defs/VoiceRosterSnapshot"}}}},
    {"if":{"properties":{"kind":{"const":"voice.roster.unavailable"}},"required":["kind"]},"then":{"properties":{"payload":{"$ref":"#/$defs/VoiceRosterUnavailable"}}}},
    {"if":{"properties":{"kind":{"const":"voice.roster.snapshot.v2"}},"required":["kind"]},"then":{"properties":{"payload":{"$ref":"#/$defs/VoiceRosterSnapshotV2"}}}},
    {"if":{"properties":{"kind":{"const":"voice.roster.unavailable.v2"}},"required":["kind"]},"then":{"properties":{"payload":{"$ref":"#/$defs/VoiceRosterUnavailableV2"}}}},
    {"if":{"properties":{"kind":{"const":"maintenance.snapshot"}},"required":["kind"]},"then":{"properties":{"payload":{"type":"object","additionalProperties":false,"required":["version","generation","revision","active"],"properties":{"version":{"const":1},"generation":{"type":"string","format":"uuid"},"revision":{"type":"integer","minimum":1,"maximum":9007199254740991},"active":{"type":"boolean"}}}}}},
    {"if":{"properties":{"kind":{"const":"maintenance.changed"}},"required":["kind"]},"then":{"properties":{"payload":{"type":"object","additionalProperties":false,"required":["version","generation","revision","active"],"properties":{"version":{"const":1},"generation":{"type":"string","format":"uuid"},"revision":{"type":"integer","minimum":1,"maximum":9007199254740991},"active":{"type":"boolean"}}}}}},
    {"if":{"properties":{"kind":{"const":"notification.queued"}},"required":["kind"]},"then":{"properties":{"payload":{"type":"object","additionalProperties":false,"properties":{"version":{"const":1},"ref":{"type":"string","format":"uuid"},"binding_ref":{"type":"string","format":"uuid"},"generation":{"type":"integer","minimum":1,"maximum":1000000000},"kind":{"enum":["DM","TEXT"]},"conversation_id":{"type":"string","format":"uuid"},"message_id":{"type":"string","format":"uuid"}},"required":["version","ref","binding_ref","generation","kind","conversation_id","message_id"]}}}},
    {"if":{"properties":{"kind":{"const":"notification.preferences_changed"}},"required":["kind"]},"then":{"properties":{"payload":{"type":"object","additionalProperties":false,"properties":{"version":{"const":1},"revision":{"type":"integer","minimum":1}},"required":["version","revision"]}}}},
    {"if": {"properties": {"kind": {"const": "session.state_changed"}}, "required": ["kind"]}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "maxProperties": 0}}}},
    {"if": {"properties": {"kind": {"const": "guild.profile.updated"}}, "required": ["kind"]}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["revision"], "properties": {"revision": {"type": "integer", "minimum": 1}}}}}},
    {"if": {"properties": {"kind": {"const": "member.profile.updated"}}, "required": ["kind"]}, "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "required": ["user_id", "revision"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "revision": {"type": "integer", "minimum": 1}}}}}},
    {
      "if": { "properties": { "kind": { "const": "connection.resync_required" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {
              "reason": { "type": "string", "enum": ["event_overflow", "server_restart", "cursor_expired", "cursor_invalid", "replay_limit", "replay_unavailable"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "voice.lease_revoked" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
              "required": ["lease_id", "reason"],
            "properties": {
              "lease_id": { "type": "string", "format": "uuid" },
              "reason": { "type": "string", "enum": ["TRANSFER", "KICK", "CHANNEL_CLOSED", "SESSION_REVOKED", "BANNED", "LOGOUT", "VOLUNTARY_LEAVE", "AFK_MOVE"] },
              "target_channel_id": { "type": "string", "format": "uuid" }
              },
              "allOf": [
                {"if": {"properties": {"reason": {"const": "AFK_MOVE"}}, "required": ["reason"]}, "then": {"required": ["target_channel_id"]}},
                {"if": {"properties": {"reason": {"enum": ["TRANSFER", "KICK", "CHANNEL_CLOSED", "SESSION_REVOKED", "BANNED", "LOGOUT", "VOLUNTARY_LEAVE"]}}, "required": ["reason"]}, "then": {"not": {"required": ["target_channel_id"]}}}
              ]
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "channel.updated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revision"],
            "properties": { "revision": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "role.permissions.updated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "revision"],
            "properties": {
              "role": { "const": "MEMBER" },
              "revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "auth.permissions.invalidated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "direct_message.message_created" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direct_message_id", "message_id"],
            "properties": {
              "direct_message_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "direct_message.message_updated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direct_message_id", "message_id", "revision"],
            "properties": {
              "direct_message_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" },
              "revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "direct_message.message_deleted" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direct_message_id", "message_id", "revision"],
            "properties": {
              "direct_message_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" },
              "revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "enum": ["message.created", "message.updated", "message.deleted"] } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel_id", "message_id"],
            "properties": {
              "channel_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "presence.snapshot" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["online_user_ids"],
            "properties": { "online_user_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }, "idle_user_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "presence.changed" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user_id", "presence"],
            "properties": {
              "user_id": { "type": "string", "format": "uuid" },
              "presence": { "type": "string", "enum": ["online", "offline"] },
              "activity_state": { "type": "string", "enum": ["active", "idle"] }
            }
          }
        }
      }
    }, {
      "if": { "properties": { "kind": { "const": "screen_preview.updated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": ["lease_id", "generation_id", "revision"],
            "properties": {
              "lease_id": { "type": "string", "format": "uuid" },
              "generation_id": { "type": "string", "format": "uuid" },
              "revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }, {
      "if": { "properties": { "kind": { "const": "screen_preview.invalidated" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": ["lease_id", "generation_id"],
            "properties": {
              "lease_id": { "type": "string", "format": "uuid" },
              "generation_id": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "screen_viewers.changed" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "screen_telemetry.updated" } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/ScreenTelemetryEventV1" } } }
    },
    {"if": {"properties": {"kind": {"enum": ["message.reactions_updated","message.pins_updated"]}},"required": ["kind"]},"then": {"properties": {"payload": {"type": "object","additionalProperties": false,"required": ["channel_id","message_id"],"properties": {"channel_id": {"type": "string","format": "uuid"},"message_id": {"type": "string","format": "uuid"}}}}}},
    {"if": {"properties": {"kind": {"enum": ["direct_message.reactions_updated"]}},"required": ["kind"]},"then": {"properties": {"payload": {"type": "object","additionalProperties": false,"required": ["direct_message_id","message_id"],"properties": {"direct_message_id": {"type": "string","format": "uuid"},"message_id": {"type": "string","format": "uuid"}}}}}}
  ]
}
