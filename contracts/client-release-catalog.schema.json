{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boohtacord.example/contracts/client-release-catalog.schema.json",
  "title": "BOOHTACORD client release catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_revision", "application_family", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "application_family": {"const": "boohtacord"},
    "entries": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "distribution", "channel", "arch", "state", "target"],
      "properties": {
        "platform": {"enum": ["web", "android", "ios", "windows", "macos"]},
        "distribution": {"enum": ["browser", "direct", "google_play", "app_store", "testflight", "development", "microsoft_store", "mac_app_store"]},
        "channel": {"enum": ["stable", "beta", "development"]},
        "arch": {"enum": ["any", "arm64", "x64", "armv7"]},
        "state": {"enum": ["published", "unconfigured", "disabled"]},
        "target": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/target"}]}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "published"}}}, "then": {"properties": {"target": {"$ref": "#/$defs/target"}}}},
        {"if": {"properties": {"state": {"enum": ["unconfigured", "disabled"]}}}, "then": {"properties": {"target": {"type": "null"}}}}
      ]
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "release_order", "version", "native_build", "priority", "published_at", "summary", "release_notes_url", "requirements", "action"],
      "properties": {
        "release_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$"},
        "release_order": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "version": {"type": "string", "maxLength": 64},
        "native_build": {"type": ["string", "null"], "maxLength": 64},
        "priority": {"enum": ["normal", "important"]},
        "published_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "maxLength": 1000},
        "release_notes_url": {"type": ["string", "null"], "maxLength": 2048},
        "installArtifact": {"type":"object","additionalProperties":false,"required":["schema_version","key_id","payload","signature"],"properties":{"schema_version":{"const":1},"key_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,96}$"},"payload":{"type":"string","maxLength":16384,"contentEncoding":"base64","description":"Ed25519 authenticated desktop-update-artifact.schema.json bytes; the client authenticates with an embedded publisher root, never a key from the server."},"signature":{"type":"string","minLength":88,"maxLength":88,"contentEncoding":"base64"}}},
    "requirements": {"$ref": "#/$defs/requirements"},
        "action": {"$ref": "#/$defs/action"},
        "install_artifact": {"$ref": "#/$defs/installArtifact"}
      }
    },
    "requirements": {
      "type": "object", "additionalProperties": false, "required": ["supported_arches"],
      "properties": {
        "min_os_version": {"type": "string", "maxLength": 64},
        "min_android_sdk": {"type": "integer", "minimum": 1},
        "supported_arches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["any", "arm64", "x64", "armv7"]}}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["kind", "url"],
      "properties": {
        "kind": {"enum": ["reload", "open_download_page", "open_store", "open_instructions"]},
        "url": {"type": ["string", "null"], "maxLength": 2048}
      }
    }
  }
}
