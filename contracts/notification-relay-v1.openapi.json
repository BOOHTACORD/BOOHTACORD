  "components": {
    "schemas": {
      "Payload": {
        "title": "Neutral notification data v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "generation",
          "binding_ref",
          "notification_ref",
          "template",
          "expires_at",
          "group_ref"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "binding_ref": {
            "type": "string",
            "format": "uuid"
          },
          "notification_ref": {
            "type": "string",
            "format": "uuid"
          },
          "group_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "template": {
            "enum": [
              "direct_message",
              "mention",
              "activity"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+]00:00)$"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payload",
          "signature"
        ],
        "properties": {
          "payload": {
            "type": "string",
            "maxLength": 8192
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        }
      },
      "Challenge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "target_kind",
          "public_key",
          "platform",
          "namespace"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096
          },
          "target_kind": {
            "enum": [
              "fcm_fid",
              "fcm_token"
            ]
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "platform": {
            "enum": [
              "android",
              "ios"
            ]
          },
          "namespace": {
            "enum": [
              "staging",
              "production"
            ]
          }
        }
      },
      "Enrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "device_id",
          "state",
          "expires_at"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "pending",
              "active"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Proof": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id",
          "nonce"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid"
          },
          "nonce": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "Pair": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin",
          "installation_id",
          "installation_public_key",
          "binding_id",
          "generation",
          "namespace",
          "nonce"
        ],
        "properties": {
          "origin": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "installation_public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "binding_id": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "namespace": {
            "enum": [
              "staging",
              "production"
            ]
          },
          "nonce": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "Notification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "payload"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "format": "uuid"
          },
          "payload": {
            "$ref": "#/components/schemas/Payload"
          }
        }
      },
      "StatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "job_ref"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "format": "uuid"
          },
          "job_ref": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "job_ref",
          "state",
          "expires_at"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "job_ref": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "accepted_by_relay",
              "accepted_by_provider",
              "retry",
              "delivery_unknown",
              "invalid_binding",
              "permanent_failure",
              "expired",
              "revoked",
              "rejected"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "status",
          "provider_available"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "status": {
            "const": "ok"
          },
          "provider_available": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "RelaySignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Relay-Signature",
        "description": "Unpadded base64url Ed25519 signature; device public key from proved enrollment or pinned tenant installation key."
      }
    }
  }
}
