{
  "openapi": "3.1.1",
  "info": {
    "title": "Dedicated publisher push relay",
    "version": "1.0.0",
    "description": "Separate database and publisher deployment; no guild cookies or incoming trace context. HTTPS only in deployment. Canonical Ed25519 signing: notification-relay-request/v1 + LF role,subject,method,path,timestamp,nonce,hex SHA256 exact body. Timestamp UTC whole seconds within 60s; durable nonce replay fence. Device grant approval requires physical provider challenge possession. Namespace and installation public key pin are immutable. Duplicate logical request needs a fresh signed nonce and stable job_ref. Acceptance never proves OS display/read."
  },
