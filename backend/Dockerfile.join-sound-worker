FROM golang:1.26.4-alpine@sha256:3ad57304ad93bbec8548a0437ad9e06a455660655d9af011d58b993f6f615648 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/join-sound-worker ./cmd/join-sound-worker
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /worker ./cmd/join-sound-worker

FROM alpine:3.22@sha256:bfe7ceb9f09ec0566c48fb93356e45a47a00be5a1dd14fa5b909e7709c66b034
RUN apk add --no-cache ffmpeg=6.1.2-r2 && adduser -D -u 65532 worker
COPY --from=build /worker /worker
USER 65532:65532
ENTRYPOINT ["/worker"]
