# Append at END of sshd_config, after existing global/Match configuration.
# Dedicated transport account only. Do not substitute an operator/root account.
Match User $monitor_user
    AuthorizedKeysFile /etc/ssh/boohtacord-otel.authorized_keys
    AuthenticationMethods publickey
    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AllowTcpForwarding local
    AllowStreamLocalForwarding no
    PermitOpen 127.0.0.1:4318
    PermitListen none
    GatewayPorts no
    PermitTunnel no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    PermitUserRC no
    MaxSessions 0
    ForceCommand /usr/bin/false
Match all
