  "corrected_harness_utf8": "\"\"\"Disposable tiny OCI fixture: real BuildKit/cache/import/cleanup, not application acceptance.\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport signal\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport shutil\nimport platform\nimport textwrap\nfrom contextlib import contextmanager\n\nROOT = Path(sys.argv[1]).resolve()\nsys.path.insert(0, str(ROOT))\nfrom tools.build.server.buildx import configure\nfrom tools.build.server.builder_storage import BuilderStorage\nfrom tools.build.server.images import build\nfrom tools.build.server.metrics import Metrics\n\nresult = Path(sys.argv[2])\ncode_paths = ['tools/build/server/'+name for name in (\n    'builder_storage.py','storage_lease.py','storage_docker.py','oci_import.py','images.py','metrics.py','layer_cache.py','cache_layout.py','buildx.py','smoke.py','buildkit-image.json')]\nhashes = {name: hashlib.sha256((ROOT/name).read_bytes()).hexdigest() for name in code_paths}\nreport = dict(schema_version=1, scope='real-tiny-OCI-builder-storage-fixture', status='RUNNING',\n              application_acceptance='NOT_RUN', production_release='NOT_RUN', tested_code_sha256=hashes,\n              buildkit_image=json.loads((ROOT/'tools/build/server/buildkit-image.json').read_text())['image'],\n              environment=dict(system=platform.system(),machine=platform.machine(),python=platform.python_version()),\n              harness_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),runs=[])\ndef save():\n    result.write_text(json.dumps(report,indent=2)+'\\n')\nsave()\n@contextmanager\ndef owned_work():\n    work=Path(tempfile.mkdtemp(prefix=\"qa394-owned-\"))\n    try:\n        yield work\n    finally:\n        if not (work/\"lease/active.json\").exists():\n            shutil.rmtree(work)\n\ndef execute():\n    with owned_work() as work:\n        source = work/'source'\n        for name in ('backend','clients/web','tools'):\n            (source/name).mkdir(parents=True,exist_ok=True)\n        for name, data in {\n            'tools/toolchains.json':(ROOT/'tools/toolchains.json').read_text(),\n            'backend/Dockerfile':'FROM scratch\\nCOPY marker.txt /marker.txt\\n',\n            'clients/web/Dockerfile':'FROM scratch\\nCOPY marker.txt /marker.txt\\n',\n            'backend/go.mod':'module fixture.invalid/qa394\\n', 'backend/go.sum':'',\n            'clients/web/package.json':'{}\\n', 'clients/web/package-lock.json':'{}\\n',\n            'backend/marker.txt':'QA394 synthetic fixture\\n','marker.txt':'QA394 synthetic fixture\\n',\n        }.items():\n            (source/name).write_text(data)\n        revision = hashlib.sha1(b'qa394-owned-tiny-oci-fixture-v1').hexdigest()\n        source_hash = hashlib.sha256(b'qa394-synthetic-source-not-a-product-release').hexdigest()\n        report.update(fixture_revision=revision,fixture_archive_sha256=source_hash,\n                      image_identity_note='Synthetic fixture identity, not a product Git checkout or shipping archive')\n        shared = dict(BOOHTACORD_SERVER_CACHE_ROOT=str(work/'cache'), VITE_PUBLIC_ORIGIN='https://qa.invalid')\n        sdk=ROOT/'public-toolcache/docker-buildx'\n        policy=json.loads((ROOT/'tools/toolchains.json').read_text())\n        client_sha256=('e5cc9fe3bbff5cbc91230981f7860e06076110730a2db997082652199042a1f2' if platform.machine()=='aarch64' else policy['buildx_linux_amd64_sha256'])\n        assert hashlib.sha256(sdk.read_bytes()).hexdigest()==client_sha256\n        config=work/'docker';plugin=config/'cli-plugins/docker-buildx';plugin.parent.mkdir(parents=True)\n        shutil.copyfile(sdk,plugin);plugin.chmod(0o755)\n        base_environment = dict(os.environ,DOCKER_CONFIG=str(config)) | shared\n        report['public_buildx_binary_sha256']=client_sha256\n        report['production_x64_acceptance']='NOT_RUN'\n        for index in ([] if \"--recovery-only\" in sys.argv[3:] else range(2)):\n            output = work/('output-'+str(index));output.mkdir()\n            environment = base_environment\n            metrics = Metrics(work/('metrics-'+str(index)+'.json'),revision)\n            scope = BuilderStorage(ROOT,environment,revision,source_hash,lease_root=work/'lease')\n            metrics.value['builder_storage'] = scope.report\n            started=time.monotonic()\n            with metrics.stage('owned_builder'):\n                with scope:\n                    receipts=build(source,output,revision,source_hash,scope.environment,metrics=metrics)\n            metrics.complete({name:row['index_digest'] for name,row in receipts.items()})\n            row=json.loads(metrics.path.read_text())\n            assert scope.report['owned_resources_removed'] is True\n            assert scope.report['removed_image_count']==2\n            assert all(value['import']==('COLD' if index==0 else 'WARM_VERIFIED') for value in row['cache'].values())\n            report['runs'].append(dict(index=index,seconds=round(time.monotonic()-started,6),metrics=row,receipts=receipts))\n            save()\n        # A hard-stopped controller cannot run finally. The next exclusive lease must\n        # identify and remove that exact orphan before creating another backend.\n        environment=base_environment\n        child_code='''import os,signal,sys\n    from pathlib import Path\n    sys.path.insert(0,sys.argv[1])\n    from tools.build.server.builder_storage import BuilderStorage\n    from tools.build.server.smoke import docker,wait_database\n    with BuilderStorage(Path(sys.argv[1]),os.environ,sys.argv[2],sys.argv[3],lease_root=Path(sys.argv[4])) as scope:\n        network='release-smoke-'+scope.environment['BOOHTACORD_BUILD_OWNER'][:12]\n        docker('network','create',network,environment=scope.environment)\n        database=docker('run','-d','--rm','--network',network,'--tmpfs','/var/lib/postgresql/data',\n            '-e','POSTGRES_DB=voice_platform_test','-e','POSTGRES_USER=voice_platform_test',\n            '-e','POSTGRES_HOST_AUTH_METHOD=trust','postgres:17.6-alpine',environment=scope.environment)\n        wait_database(database,environment=scope.environment)\n        os.kill(os.getpid(),signal.SIGKILL)\n    '''\n        child_code=textwrap.dedent(\"    \"+child_code)\n        compile(child_code,\"<qa394-hard-stop-controller>\",\"exec\")\n        child=subprocess.run([sys.executable,'-c',child_code,str(ROOT),revision,source_hash,str(work/'lease')],\n                             env=environment,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=240)\n        report['hard_stop_child_returncode']=child.returncode\n        save()\n        assert child.returncode==-signal.SIGKILL\n        assert (work/'lease/active.json').is_file()\n        recovered=BuilderStorage(ROOT,base_environment,revision,source_hash,lease_root=work/'lease')\n        with recovered:\n            assert recovered.report['recovered_previous_lease'] is True\n        assert recovered.report['owned_resources_removed'] is True\n        assert recovered.report['removed_smoke_container_count']==1 and recovered.report['removed_smoke_network_count']==1\n        assert not (work/'lease/active.json').exists()\n        report['hard_stop_recovery']=dict(status='PASS',child_exit_code=child.returncode,storage=recovered.report)\n\ntry:\n    execute()\nexcept BaseException as error:\n    report.update(status=\"FAIL\",failure_type=type(error).__name__)\n    save()\n    raise\nassert hashes=={name:hashlib.sha256((ROOT/name).read_bytes()).hexdigest() for name in code_paths}\nreport.update(status='PASS',fixture_files_removed=True)\nsave()\nprint(json.dumps(dict(status=report['status'], runs=[dict(index=r['index'],seconds=r['seconds'],cache=r['metrics']['cache'],storage=r['metrics']['builder_storage']) for r in report['runs']],hard_stop_recovery=report['hard_stop_recovery'])))\n",
