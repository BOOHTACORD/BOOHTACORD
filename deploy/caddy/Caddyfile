{$PUBLIC_HOST:localhost} {
	route {
		encode zstd gzip
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
		}

		@upload_http1 {
			method POST
			path_regexp upload_http1 ^/api/v1/(channels|direct-messages)/[^/]+/attachments$
			expression `{http.request.proto}.startsWith("HTTP/1.")`
		}
		reverse_proxy @upload_http1 api:8080 {
			@upload_timeout status 408
			handle_response @upload_timeout {
				header Connection close
				copy_response
			}
		}

		@api path /api /api/*
		reverse_proxy @api api:8080

		@rtc path /rtc /rtc/*
		log_skip @rtc
		handle @rtc {
			forward_auth api:8080 {
				uri /internal/media-admission
				header_up X-Forwarded-Uri {uri}
				header_up X-Forwarded-Method {method}
				header_up Authorization {http.request.header.Authorization}
			}
			reverse_proxy livekit:7880
		}

		@private_metrics path /metrics /metrics/*
		respond @private_metrics "Not Found" 404

		reverse_proxy web:80
	}
}
